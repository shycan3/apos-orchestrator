{
  "manifest_version": 3,
  "name": "APOS v3.2 + Bridge Protocol Web-Local Orchestrator",
  "version": "3.2.0",
  "description": "Detects APOS patch envelopes from web LLM UIs and sends them to the local APOS validation server.",
  "permissions": [],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "bridgeUtils.js",
        "contentScript.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
